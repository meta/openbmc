From 387e78c72c42420e144fb9b0713ea8398fea2b53 Mon Sep 17 00:00:00 2001
From: Peter Yin <peter.yin@quantatw.com>
Date: Thu, 2 Oct 2025 16:08:10 +0800
Subject: [PATCH] ARM: uboot: dts: add facebook common dts

Add facebook common dts.
---
 arch/arm/dts/Makefile             |  3 +-
 arch/arm/dts/ast2700-facebook.dts | 46 +++++++++++++++++++++++++++++++
 2 files changed, 48 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/dts/ast2700-facebook.dts

diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index 37d3b6fd3cce..b148fc19c98f 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -1025,7 +1025,8 @@ dtb-$(CONFIG_ASPEED_AST2600) += \
 	ast2600-sbp1.dtb \
 	ast2600-x4tf.dtb
 dtb-$(CONFIG_ASPEED_AST2700) += \
-	ast2700-evb.dtb
+	ast2700-evb.dtb \
+	ast2700-facebook.dtb
 
 dtb-$(CONFIG_STM32MP15X) += \
 	stm32mp157c-odyssey.dtb
diff --git a/arch/arm/dts/ast2700-facebook.dts b/arch/arm/dts/ast2700-facebook.dts
new file mode 100644
index 000000000000..0dee592da195
--- /dev/null
+++ b/arch/arm/dts/ast2700-facebook.dts
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+/dts-v1/;
+
+#include "ast2700.dtsi"
+#include "ast2700-u-boot.dtsi"
+
+/ {
+	model = "Facebook BMC";
+	compatible = "facebook,yosemite5a7-bmc", "aspeed,ast2700";
+
+	memory@400000000 {
+		device_type = "memory";
+		reg = <0x4 0x00000000 0x0 0x80000000>;
+	};
+
+	chosen {
+		stdout-path = &uart12;
+	};
+};
+
+&uart12 {
+	status = "okay";
+};
+
+&fmc {
+	status = "okay";
+
+	flash@0 {
+		status = "okay";
+		spi-max-frequency = <50000000>;
+		spi-tx-bus-width = <2>;
+		spi-rx-bus-width = <2>;
+	};
+
+	flash@1 {
+		status = "okay";
+		spi-max-frequency = <50000000>;
+		spi-tx-bus-width = <2>;
+		spi-rx-bus-width = <2>;
+	};
+};
+
+&wdt0 {
+	status = "okay";
+};
-- 
2.53.0

