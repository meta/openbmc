diff --git a/yaml/xyz/openbmc_project/State/Accelerator.events.yaml b/yaml/xyz/openbmc_project/State/Accelerator.events.yaml
new file mode 100644
index 00000000..82f1581b
--- /dev/null
+++ b/yaml/xyz/openbmc_project/State/Accelerator.events.yaml
@@ -0,0 +1,64 @@
+version: 1.0.0
+
+description: >
+    Events indicating accelerator error conditions, status changes, and recovery
+    from previously reported conditions.
+
+    A Source object may be provided to associate the resulting log entry with an
+    accelerator inventory object.
+
+errors:
+    - name: AcceleratorFailed
+      severity: error
+      errno: EIO
+
+      metadata:
+          - name: Source
+            type: object_path
+            primary: true
+            description: >
+                The inventory object associated with the accelerator.
+
+          - name: FailureType
+            type: string
+            description: >
+                An [optional] identifier of the failure type.
+
+      en:
+          description: An accelerator has been detected in a failure state.
+          message: The accelerator '{Source}' is in a failure state.
+
+    - name: AcceleratorCritical
+      severity: critical
+      errno: EIO
+
+      metadata:
+          - name: Source
+            type: object_path
+            primary: true
+            description: >
+                The inventory object associated with the accelerator.
+
+          - name: FailureType
+            type: string
+            description: >
+                An [optional] identifier of the failure type.
+
+      en:
+          description:
+              An accelerator has been detected in a critical failure state.
+          message: The accelerator '{Source}' is in a critical failure state.
+
+events:
+    - name: AcceleratorRestored
+
+      metadata:
+          - name: Source
+            type: object_path
+            primary: true
+            description: >
+                The inventory object associated with the accelerator.
+
+      en:
+          description: The accelerator status has been restored.
+          message: The accelerator '{Source}' has been restored.
-- 
