From fc6da5726c0e93364c7533e2d5f55c54c0603799 Mon Sep 17 00:00:00 2001
From: Abhijeet Singh <abhijeet.singh@amd.com>
Date: Tue, 20 Oct 2026 21:19:33 +0000
Subject: [PATCH] State: add power supply fault and recovery events

These events provide a common mechanism for reporting
power supply fault conditions, and recovery events,
while allowing the event to be associated with an
power supply inventory object.
---
 .../State/PowerSupply/meson.build             |  29 +
 gen/xyz/openbmc_project/State/meson.build     | 659 +++++++-----------
 .../State/PowerSupply.events.yaml             |  49 ++
 3 files changed, 311 insertions(+), 426 deletions(-)
 create mode 100644 gen/xyz/openbmc_project/State/PowerSupply/meson.build
 create mode 100644 yaml/xyz/openbmc_project/State/PowerSupply.events.yaml

diff --git a/gen/xyz/openbmc_project/State/PowerSupply/meson.build b/gen/xyz/openbmc_project/State/PowerSupply/meson.build
new file mode 100644
index 00000000..0205e470
--- /dev/null
+++ b/gen/xyz/openbmc_project/State/PowerSupply/meson.build
@@ -0,0 +1,29 @@
+# Generated file; do not modify.
+
+sdbusplus_current_path = 'xyz/openbmc_project/State/PowerSupply'
+
+generated_sources += custom_target(
+    'xyz/openbmc_project/State/PowerSupply__cpp'.underscorify(),
+    input: [
+        '../../../../../yaml/xyz/openbmc_project/State/PowerSupply.events.yaml',
+    ],
+    output: [
+        'event.cpp',
+        'event.hpp',
+    ],
+    depend_files: sdbusplusplus_depfiles,
+    command: [
+        sdbuspp_gen_meson_prog, '--command', 'cpp',
+        '--output', meson.current_build_dir(),
+        '--tool', sdbusplusplus_prog,
+        '--directory', meson.current_source_dir() / '../../../../../yaml',
+        'xyz/openbmc_project/State/PowerSupply',
+    ],
+    install: should_generate_cpp,
+    install_dir: [
+        false,
+        get_option('includedir') / sdbusplus_current_path,
+    ],
+    build_by_default: should_generate_cpp,
+)
+
