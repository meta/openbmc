From b7697432705e3a649857ff3936f2d20b92486d3d Mon Sep 17 00:00:00 2001
From: Marco Kawajiri <kawajiri@meta.com>
Date: Wed, 5 Feb 2025 09:42:22 -0800
Subject: [PATCH] Set request timeout to 120s on
 bmcweb/http/http_connection.hpp

Large platforms (yosemite4 with 8 slots, ~1,300 sensors) need well over
the upstream 15 s to build deep Redfish $expand responses: 40 s was
enough for Sensors?$expand=* (D69186296), but
Chassis?$expand=.($levels=3) takes 95-100 s on a busy yosemite4.

Change-Id: Ieb9c9569a141cbb194fa362ac0426a9e8127becf
---
 http/http_connection.hpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/http/http_connection.hpp b/http/http_connection.hpp
index d5c51214..34db9bc2 100644
--- a/http/http_connection.hpp
+++ b/http/http_connection.hpp
@@ -931,7 +931,7 @@ class Connection :
             return;
         }
 
-        int timeoutDurationSeconds = 15;
+        int timeoutDurationSeconds = 120;
         if (timerType == DeadlineTimerType::Keepalive)
         {
             // if we're waiting for future requests while idle in keepalive,
-- 
