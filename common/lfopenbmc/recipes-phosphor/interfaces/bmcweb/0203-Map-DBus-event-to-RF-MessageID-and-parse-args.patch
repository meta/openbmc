@@ -0,0 +1,123 @@
+#include "utils/dbus_registries_map_utils.hpp"
+
+#include "event_logs_object_type.hpp"
+#include "external_registries_map.hpp"
+#include "logging.hpp"
+#include "registries.hpp"
