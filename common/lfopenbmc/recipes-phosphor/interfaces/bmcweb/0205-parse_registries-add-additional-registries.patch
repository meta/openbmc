From e5036a38a1603976173704e4b5014edd3828eede Mon Sep 17 00:00:00 2001
From: Patrick Williams <patrick@stwcx.xyz>
Date: Fri, 11 Sep 2026 12:17:38 -0400
Subject: [PATCH] parse_registries: add additional registries

Phosphor-dbus-interfaces has added support for events that map to
additional Redfish message registries not currently exposed.

```
$ rg redfish-mapping | sed "s#.*redfish-mapping: ##" | sed "s#\..*##" | sort | uniq
Base
Environmental
SensorEvent
Telemetry
Update
```

Add these to the exported list.

Tested:

```
$ curl -s -k https://localhost:18080/redfish/v1/Registries/ | jq '.Members | map(."@odata.id")'
[
  "/redfish/v1/Registries/Base",
  "/redfish/v1/Registries/Environmental",
  "/redfish/v1/Registries/HeartbeatEvent",
  "/redfish/v1/Registries/OpenBMC",
  "/redfish/v1/Registries/ResourceEvent",
  "/redfish/v1/Registries/SensorEvent",
  "/redfish/v1/Registries/TaskEvent",
  "/redfish/v1/Registries/Telemetry",
  "/redfish/v1/Registries/Update"
]
```

Upstream-Status: Submitted [https://gerrit.openbmc.org/c/openbmc/bmcweb/+/94454]
Signed-off-by: Patrick Williams <patrick@stwcx.xyz>
Change-Id: I7dc0947f35128b214bac0d8b19c0ff16a3cbc630
---
 redfish-core/include/registries_selector.hpp | 3 +++
 scripts/parse_registries.py                  | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/redfish-core/include/registries_selector.hpp b/redfish-core/include/registries_selector.hpp
index 9e05cf34..7d0f0f84 100644
--- a/redfish-core/include/registries_selector.hpp
+++ b/redfish-core/include/registries_selector.hpp
@@ -3,9 +3,12 @@
 #pragma once
 // NOLINTBEGIN(misc-include-cleaner)
 #include "registries/base_message_registry.hpp"
+#include "registries/environmental_message_registry.hpp"
 #include "registries/heartbeat_event_message_registry.hpp"
 #include "registries/openbmc_message_registry.hpp"
 #include "registries/resource_event_message_registry.hpp"
+#include "registries/sensor_event_message_registry.hpp"
 #include "registries/task_event_message_registry.hpp"
 #include "registries/telemetry_message_registry.hpp"
+#include "registries/update_message_registry.hpp"
 // NOLINTEND(misc-include-cleaner)
diff --git a/scripts/parse_registries.py b/scripts/parse_registries.py
index 5e9e6bae..d6cc261c 100755
--- a/scripts/parse_registries.py
+++ b/scripts/parse_registries.py
@@ -703,12 +703,15 @@ def main() -> None:
     # Registries generated and exposed by default.
     default_registries = [
         "base",
+        "environmental",
         "heartbeat_event",
         "openbmc",
         "privilege",
         "resource_event",
+        "sensor_event",
         "task_event",
         "telemetry",
+        "update",
     ]
 
     parser = argparse.ArgumentParser()
