From 1e4a5e8fc08a1d029e0058344a07e40d70a7e84e Mon Sep 17 00:00:00 2001
From: Jagpal Singh Gill <jagpalgill@meta.com>
Date: Fri, 13 Nov 2026 15:07:31 -0800
Subject: [PATCH] registries: restore complete default registry exposure

Expose all existing generated DMTF message registries through registries_selector.hpp. This restores SensorEvent and the other registries omitted by the reduced upstream selector.

Use the complete known registry set as the generator default so regeneration preserves selector coverage. Explicit registry selections and vendor registry generation retain their existing behavior.
---
 redfish-core/include/registries_selector.hpp | 13 +++++++++++++
 scripts/parse_registries.py                  | 10 +---------
 2 files changed, 14 insertions(+), 9 deletions(-)

diff --git a/redfish-core/include/registries_selector.hpp b/redfish-core/include/registries_selector.hpp
index 9e05cf34..71a628db 100644
--- a/redfish-core/include/registries_selector.hpp
+++ b/redfish-core/include/registries_selector.hpp
@@ -3,9 +3,22 @@
 #pragma once
 // NOLINTBEGIN(misc-include-cleaner)
 #include "registries/base_message_registry.hpp"
+#include "registries/composition_message_registry.hpp"
+#include "registries/environmental_message_registry.hpp"
+#include "registries/ethernet_fabric_message_registry.hpp"
+#include "registries/fabric_message_registry.hpp"
 #include "registries/heartbeat_event_message_registry.hpp"
+#include "registries/job_event_message_registry.hpp"
+#include "registries/license_message_registry.hpp"
+#include "registries/log_service_message_registry.hpp"
+#include "registries/network_device_message_registry.hpp"
 #include "registries/openbmc_message_registry.hpp"
+#include "registries/platform_message_registry.hpp"
+#include "registries/power_message_registry.hpp"
 #include "registries/resource_event_message_registry.hpp"
+#include "registries/sensor_event_message_registry.hpp"
+#include "registries/storage_device_message_registry.hpp"
 #include "registries/task_event_message_registry.hpp"
 #include "registries/telemetry_message_registry.hpp"
+#include "registries/update_message_registry.hpp"
 // NOLINTEND(misc-include-cleaner)
diff --git a/scripts/parse_registries.py b/scripts/parse_registries.py
index 8273a184..7371e471 100755
--- a/scripts/parse_registries.py
+++ b/scripts/parse_registries.py
@@ -962,15 +962,7 @@ def main() -> None:
     )
 
     # Registries generated and exposed by default.
-    default_registries = [
-        "base",
-        "heartbeat_event",
-        "openbmc",
-        "privilege",
-        "resource_event",
-        "task_event",
-        "telemetry",
-    ]
+    default_registries = list(dmtf_registries) + ["openbmc", "privilege"]
 
     parser = argparse.ArgumentParser()
     parser.add_argument(
