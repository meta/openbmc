@@ -0,0 +1,160 @@
+{
+    "$schema": "https://json-schema.org/draft/2020-12/schema",
+    "type": "object",
+    "description": "MTIA (Meta Training and Inference Accelerator) OEM Error Section",
+    "required": [
+        "version",
+        "recordSize",
+        "bootTimer",
+        "eventId",
+        "severity",
+        "scope",
+        "chipId",
+        "platformId",
+        "skuId",
+        "chipletId",
+        "moduleId",
+        "detailFormatId",
+        "eventDetailRaw"
+    ],
+    "additionalProperties": false,
+    "properties": {
+        "version": {
+            "type": "object",
+            "description": "Major and minor version number of the MTIA section definition.",
+            "required": ["major", "minor"],
+            "additionalProperties": false,
+            "properties": {
+                "major": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "minor": {
+                    "type": "integer",
+                    "minimum": 0
+                }
+            }
+        },
+        "recordSize": {
+            "type": "integer",
+            "description": "Size of the MTIA error record in bytes.",
+            "minimum": 0
+        },
+        "pcieDeviceId": {
+            "type": "object",
+            "description": "PCIe device identifier of the MTIA component. Present only when validation bit 0 is set.",
+            "required": [
+                "vendorId",
+                "deviceId",
+                "functionNumber",
+                "deviceNumber",
+                "busNumber",
+                "segmentNumber",
+                "slotNumber"
+            ],
+            "additionalProperties": false,
+            "properties": {
+                "vendorId": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "deviceId": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "functionNumber": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "deviceNumber": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "busNumber": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "segmentNumber": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "slotNumber": {
+                    "type": "integer",
+                    "minimum": 0
+                }
+            }
+        },
+        "deviceSerial": {
+            "type": "string",
+            "description": "ASIC serial number. Present only when validation bit 1 is set.",
+            "pattern": "^[0-9a-f]{30}$"
+        },
+        "bootTimer": {
+            "type": "integer",
+            "description": "Event time since boot, in nanoseconds.",
+            "minimum": 0
+        },
+        "eventId": {
+            "type": "integer",
+            "description": "12-bit event identifier.",
+            "minimum": 0
+        },
+        "severity": {
+            "type": "object",
+            "description": "Boot1 event severity bucket.",
+            "required": ["raw"],
+            "additionalProperties": false,
+            "properties": {
+                "raw": {
+                    "type": "integer",
+                    "minimum": 0
+                },
+                "value": {
+                    "type": "string",
+                    "enum": ["Info", "Warning", "Recoverable", "Fatal"]
+                }
+            }
+        },
+        "scope": {
+            "type": "string",
+            "description": "Event scope.",
+            "pattern": "^0x[0-9A-F]{2}$"
+        },
+        "chipId": {
+            "type": "string",
+            "description": "Chip identifier.",
+            "pattern": "^0x[0-9A-F]{2}$"
+        },
+        "platformId": {
+            "type": "string",
+            "description": "Platform identifier.",
+            "pattern": "^0x[0-9A-F]{2}$"
+        },
+        "skuId": {
+            "type": "string",
+            "description": "SKU identifier.",
+            "pattern": "^0x[0-9A-F]{2}$"
+        },
+        "chipletId": {
+            "type": "string",
+            "description": "Source chiplet identifier.",
+            "pattern": "^0x[0-9A-F]{2}$"
+        },
+        "moduleId": {
+            "type": "string",
+            "description": "Module identity.",
+            "pattern": "^0x[0-9A-F]{2}$"
+        },
+        "detailFormatId": {
+            "type": "string",
+            "description": "Identifies the format of the eventDetailRaw payload.",
+            "pattern": "^0x[0-9A-F]{2}$"
+        },
+        "eventDetailRaw": {
+            "type": "string",
+            "description": "Event detail payload, up to 48 bytes, published as-is in base64.",
+            "maxLength": 64,
+            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
+        }
+    }
+}
