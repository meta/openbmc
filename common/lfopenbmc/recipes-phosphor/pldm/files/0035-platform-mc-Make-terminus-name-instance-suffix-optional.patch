@@ -140,7 +148,7 @@ TEST_F(TerminusTest, parseSensorAuxiliaryNamesPDRTest)
     EXPECT_EQ("en", names[0][0].first);
     EXPECT_EQ("TEMP1", names[0][0].second);
     EXPECT_EQ(2, t1.pdrs.size());
-    EXPECT_EQ("S0_1", t1.getTerminusName().value());
