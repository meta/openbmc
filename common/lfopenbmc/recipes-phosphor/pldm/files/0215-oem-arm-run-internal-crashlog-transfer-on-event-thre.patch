+/** Run FileDescriptor operations on pldmd's event thread. The worker may
+ * block while draining a socket, but must never enter the PLDM requester's
+ * maps, timers or coroutine state from that thread.
+ */
+class EventThreadCalls
+{
+  public:
+    EventThreadCalls()
+    {
+        wakeFd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+        if (wakeFd < 0)
+        {
+            throw std::runtime_error("Failed to create crashlog eventfd");
+        }
+
+        sd_event* event = nullptr;
+        auto rc = sd_event_default(&event);
+        if (rc >= 0)
+        {
+            rc = sd_event_add_io(event, &source, wakeFd, EPOLLIN,
+                                 &EventThreadCalls::onWake, this);
+            sd_event_unref(event);
+        }
+        if (rc < 0)
+        {
+            sd_event_source_unref(source);
+            close(wakeFd);
+            wakeFd = -1;
+            throw std::runtime_error("Failed to watch crashlog eventfd");
+        }
+    }
+
+    ~EventThreadCalls()
+    {
+        sd_event_source_unref(source);
+        close(wakeFd);
+    }
+
+    EventThreadCalls(const EventThreadCalls&) = delete;
+    EventThreadCalls& operator=(const EventThreadCalls&) = delete;
+
+    template <typename F>
+    auto call(F&& function) -> std::invoke_result_t<F>
+    {
+        using Result = std::invoke_result_t<F>;
+        auto task = std::make_shared<std::packaged_task<Result()>>(
+            std::forward<F>(function));
+        auto result = task->get_future();
+        {
+            std::lock_guard guard(queueMutex);
+            pending.emplace_back([task] { (*task)(); });
+        }
+
+        uint64_t wake = 1;
+        ssize_t written;
+        do
+        {
+            written = write(wakeFd, &wake, sizeof(wake));
+        } while (written < 0 && errno == EINTR);
+        if (written != static_cast<ssize_t>(sizeof(wake)) &&
+            !(written < 0 && errno == EAGAIN))
+        {
+            throw std::runtime_error("Failed to wake crashlog event thread");
+        }
+        return result.get();
+    }
+
+  private:
+    static int onWake(sd_event_source*, int fd, uint32_t, void* context)
+    {
+        auto* self = static_cast<EventThreadCalls*>(context);
+        uint64_t wake;
+        ssize_t rc;
+        do
+        {
+            rc = read(fd, &wake, sizeof(wake));
+        } while (rc < 0 && errno == EINTR);
+
+        std::deque<std::function<void()>> ready;
+        {
+            std::lock_guard guard(self->queueMutex);
+            ready.swap(self->pending);
+        }
+        for (auto& task : ready)
+        {
+            task();
+        }
+        return 0;
+    }
+
+    int wakeFd = -1;
+    sd_event_source* source = nullptr;
+    std::mutex queueMutex;
+    std::deque<std::function<void()>> pending;
+};
