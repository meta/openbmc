From 06305941b893007a5cf2a41bc37d4c98148d24b9 Mon Sep 17 00:00:00 2001
From: Colin Huang <colin.huang2@amd.com>
Date: Tue, 18 Aug 2026 11:46:06 +0800
Subject: [PATCH] PSUSensor: add TDA38725 and TDA38740 support

Add device TDA38725/TDA38740 reading support for Anacapa project.

The driver has been applied into staging git [1].
and it's in process to  backport into openbmc [2].

Reference:
[1] https://lore.kernel.org/all/20260918-add-tda38740-and-tda38725-v6-1-a8b11018d850@gmail.com/
[2] https://lore.kernel.org/all/20260921-dev-6-18-tda38740-driver-v1-0-f9fd35faf911@gmail.com/#t

Gerrit: https://gerrit.openbmc.org/c/openbmc/dbus-sensors/+/94819

Change-Id: I9503742939ab987251b7df62a6a40ed0fcee4b0e
Signed-off-by: Colin Huang <colin.huang2@amd.com>
---
 src/psu/PSUSensorMain.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/psu/PSUSensorMain.cpp b/src/psu/PSUSensorMain.cpp
index 4b5cb9a..5f2280b 100644
--- a/src/psu/PSUSensorMain.cpp
+++ b/src/psu/PSUSensorMain.cpp
@@ -163,6 +163,8 @@ static constexpr auto sensorTypes = std::to_array<
     {"smpro_hwmon", I2CDeviceType{"smpro", false}},
     {"SY24655", I2CDeviceType{"sy24655", true}},
     {"TDA38640", I2CDeviceType{"tda38640", true}},
+    {"TDA38725", I2CDeviceType{"tda38725", true}},
+    {"TDA38740", I2CDeviceType{"tda38740", true}},
     {"TPS25990", I2CDeviceType{"tps25990", true}},
     {"TPS53679", I2CDeviceType{"tps53679", true}},
     {"TPS546D24", I2CDeviceType{"tps546d24", true}},
