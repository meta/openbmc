 		compatible = "aspeed,ast2700-sd-controller", "aspeed,ast2600-sd-controller";
 		reg = <0 0x14080000 0 0x100>;
@@ -247,6 +283,7 @@ adc0: adc@14c00000 {
 		resets = <&syscon1 SCU1_RESET_ADC>;
 		interrupts-extended = <&intc1 80>;
 		#io-channel-cells = <1>;
+		aspeed,scu = <&syscon1>;
 		status = "disabled";
