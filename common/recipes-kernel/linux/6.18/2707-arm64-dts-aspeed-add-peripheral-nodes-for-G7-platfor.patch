From 9d598a0bfd13da440f2d4eb0f65fd6fe462e13ba Mon Sep 17 00:00:00 2001
From: Cosmo Chou <cosmo.chou@quantatw.com>
Date: Thu, 16 Apr 2026 09:49:37 +0800
Subject: [PATCH] arm64: dts: aspeed: add peripheral nodes for G7 platforms

Add device tree nodes for peripherals in AST2700, including SGPIOM,
I2C, I3C, OTP, UDMA, FMC/SPI, MAC, ADC, LPC, and WDT.

Signed-off-by: Cosmo Chou <cosmo.chou@quantatw.com>
[Rebased onto the upstream AST2700 device tree: the nodes now live in
 aspeed-g7-soc1.dtsi. Upstream already provides the SGPIOM, FMC/SPI,
 ADC and WDT nodes, so for those only the local additions are kept:
 sgpiom0 pinctrl, the spi2 flash children and aspeed,scu on adc0/adc1.]
---
 .../arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi | 616 ++++++++++++++++++
 1 file changed, 616 insertions(+)

diff --git a/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi b/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi
index bc990f79e693..709edcaa3e2a 100644
--- a/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi
+++ b/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi
@@ -109,6 +109,22 @@ spi2: spi@14030000 {
 		interrupts-extended = <&intc1 124>;
 		num-cs = <2>;
 		status = "disabled";
+
+		flash@0 {
+			reg = < 0 >;
+			compatible = "jedec,spi-nor";
+			spi-max-frequency = <50000000>;
+			spi-rx-bus-width = <2>;
+			status = "disabled";
+		};
+
+		flash@1 {
+			reg = < 1 >;
+			compatible = "jedec,spi-nor";
+			spi-max-frequency = <50000000>;
+			spi-rx-bus-width = <2>;
+			status = "disabled";
+		};
 	};
 
