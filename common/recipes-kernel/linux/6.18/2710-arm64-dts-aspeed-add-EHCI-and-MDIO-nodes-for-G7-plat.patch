From ce0ee4181845528c101af85ebb163d692d65b56c Mon Sep 17 00:00:00 2001
From: Kyle Hsieh <Kyle.Hsieh@quantatw.com>
Date: Mon, 22 Jun 2026 09:52:20 +0800
Subject: [PATCH] arm64: dts: aspeed: add #address-cells/#size-cells to G7 MDIO
 nodes

The upstream AST2700 device tree now provides the EHCI and MDIO nodes
this patch originally added, but its MDIO nodes lack #address-cells and
#size-cells. The aspeed,ast2600-mdio binding requires both, and boards
need them to describe PHYs on these buses, so add them to mdio0-mdio2.

Signed-off-by: Kyle Hsieh <Kyle.Hsieh@quantatw.com>
[Reduced from "arm64: dts: aspeed: add EHCI and MDIO nodes for G7
 platforms" when rebasing onto the upstream AST2700 device tree, and
 extended from mdio0 to mdio1/mdio2.]
---
 arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi b/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi
index 709edcaa3e2a..f5f09abeb1d7 100644
--- a/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi
+++ b/arch/arm64/boot/dts/aspeed/aspeed-g7-soc1.dtsi
@@ -133,6 +133,8 @@ mdio0: mdio@14040000 {
 		resets = <&syscon1 SCU1_RESET_MII>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_mdio0_default>;
+		#address-cells = <1>;
+		#size-cells = <0>;
 		status = "disabled";
 	};
 
@@ -142,6 +144,8 @@ mdio1: mdio@14040008 {
 		resets = <&syscon1 SCU1_RESET_MII>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_mdio1_default>;
+		#address-cells = <1>;
+		#size-cells = <0>;
 		status = "disabled";
 	};
 
@@ -151,6 +155,8 @@ mdio2: mdio@14040010 {
 		resets = <&syscon1 SCU1_RESET_MII>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_mdio2_default>;
+		#address-cells = <1>;
+		#size-cells = <0>;
 		status = "disabled";
 	};
 
