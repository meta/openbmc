From 02f56c8bb9a695c8264f1f929eb4b3028dcef5a0 Mon Sep 17 00:00:00 2001
From: Bianca Giocas <bgiocas@arista.com>
Date: Thu, 16 Jul 2026 11:16:23 +0000
Subject: [PATCH] arm64: dts: aspeed: Enable TX FIFO retry quirk on AST2700
 VHUBA0

The VHUBA0 node this patch originally backported from
torvalds/linux@e77bb5dc5759 is now provided by the upstream AST2700
device tree. It lacks the aspeed,txfifo-retry-quirk property, which the
vendor-derived aspeed-vhub AST2700 support ("usb: gadget: aspeed-vhub:
Add AST2700 support") reads, so add it.

Signed-off-by: Bianca Giocas <bgiocas@arista.com>
[Reduced from "arm64: dts: aspeed: Add AST2700 VHUBA0 node" to the
 quirk property when rebasing onto the upstream AST2700 device tree.]
---
 arch/arm64/boot/dts/aspeed/aspeed-g7-soc0.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/aspeed/aspeed-g7-soc0.dtsi b/arch/arm64/boot/dts/aspeed/aspeed-g7-soc0.dtsi
index db42db2592e0..271c0082e442 100644
--- a/arch/arm64/boot/dts/aspeed/aspeed-g7-soc0.dtsi
+++ b/arch/arm64/boot/dts/aspeed/aspeed-g7-soc0.dtsi
@@ -69,6 +69,7 @@ vhuba0: usb-vhub@12060000 {
 		aspeed,vhub-generic-endpoints = <21>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_usb2ad0_default>;
+		aspeed,txfifo-retry-quirk;
 		status = "disabled";
 	};
 
