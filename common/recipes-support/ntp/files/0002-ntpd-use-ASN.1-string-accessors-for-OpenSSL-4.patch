From: James Athappilly <jamesatha@meta.com>
Subject: [PATCH] ntpd: decode and validate the subject key identifier

The base recipe already uses OpenSSL ASN.1 string accessors. Decode the
subject key identifier with the public extension API rather than assuming
a fixed DER header size; reject decoding and key conversion failures.

Upstream-Status: Pending

--- a/ntpd/ntp_crypto.c
+++ b/ntpd/ntp_crypto.c
@@ -3550,9 +3550,20 @@
 		 * contains the GQ public key.
 		 */
 		case NID_subject_key_identifier:
-			data = X509_EXTENSION_get_data(ext);
-			ret->grpkey = BN_bin2bn(ASN1_STRING_get0_data(data) + 2,
-			    ASN1_STRING_length(data) - 2, NULL);
+			data = X509V3_EXT_d2i(ext);
+			if (data == NULL) {
+				cert_free(ret);
+				X509_free(cert);
+				return (NULL);
+			}
+			ret->grpkey = BN_bin2bn(ASN1_STRING_get0_data(data),
+			    ASN1_STRING_length(data), NULL);
+			ASN1_OCTET_STRING_free(data);
+			if (ret->grpkey == NULL) {
+				cert_free(ret);
+				X509_free(cert);
+				return (NULL);
+			}
 			/* fall through */
 		default:
 			DPRINTF(1, ("cert_parse: %s\n",
