# The kernel config disables MTD_PARTITIONED_MASTER, so mtd1 is the "env"
# partition at 0x400000, as on the AST2620 fboss-lite machines.
#
# Device name    Device offset    Env. size    Flash sector size
/dev/mtd1        0x0000           0x20000      0x10000
