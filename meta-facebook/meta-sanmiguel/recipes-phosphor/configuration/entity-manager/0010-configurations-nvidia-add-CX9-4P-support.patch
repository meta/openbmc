From 5f418ef3591d669792f51131e8d7d24e5e169bae Mon Sep 17 00:00:00 2001
From: Potin Lai <potin.lai@quantatw.com>
Date: Thu, 5 Nov 2026 22:42:15 +0800
Subject: [PATCH 1/1] configurations: nvidia: add CX9 4P support

NVIDIA changes the FRU content from `2P` to `4P` based on physical CX9
count per bay.

Add modification to support both `2P` and `4P` of CX9 FRU.

Signed-off-by: Potin Lai <potin.lai@quantatw.com>
Change-Id: I0efbb16f6d98326170487a8e9163efe26727e59c

[1] Gerrit: https://gerrit.openbmc.org/c/openbmc/entity-manager/+/96817
---
 configurations/nvidia/cx9_mezzanine_module.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configurations/nvidia/cx9_mezzanine_module.json b/configurations/nvidia/cx9_mezzanine_module.json
index 7cdc62b3..d15eccb8 100644
--- a/configurations/nvidia/cx9_mezzanine_module.json
+++ b/configurations/nvidia/cx9_mezzanine_module.json
@@ -8,7 +8,7 @@
         }
     ],
     "Name": "NVIDIA VR NVL72 IO Board $bus - 73",
-    "Probe": "xyz.openbmc_project.FruDevice({'BOARD_PRODUCT_NAME': 'ConnectX-9 800GE 2P NIC', 'BOARD_MANUFACTURER': '(Nvidia|NVIDIA)'})",
+    "Probe": "xyz.openbmc_project.FruDevice({'BOARD_PRODUCT_NAME': 'ConnectX-9 800GE (2P|4P) NIC', 'BOARD_MANUFACTURER': '(Nvidia|NVIDIA)'})",
     "Type": "Board",
     "xyz.openbmc_project.Inventory.Decorator.Asset": {
         "BuildDate": "$BOARD_MANUFACTURE_DATE",
-- 
